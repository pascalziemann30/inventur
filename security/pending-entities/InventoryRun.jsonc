{
  "name": "InventoryRun",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string"
    },
    "outlet_name": {
      "type": "string"
    },
    "session_date": {
      "type": "string"
    },
    "period_type": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "start_key": {
      "type": "string"
    },
    "start_fingerprint": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "completed_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "posting",
        "resolving",
        "completed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "article_id": {
            "type": "string"
          },
          "article_name": {
            "type": "string"
          },
          "global_item_id": {
            "type": "string"
          },
          "stock_id": {
            "type": "string"
          },
          "supplier_id": {
            "type": "string"
          },
          "unit_id": {
            "type": "string"
          },
          "category_id": {
            "type": "string"
          },
          "category_name": {
            "type": "string"
          },
          "unit_abbreviation": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "booking_error": {
            "type": "string"
          },
          "booking_operation_id": {
            "type": "string"
          },
          "booked_at": {
            "type": "string"
          },
          "last_stock": {
            "type": "number"
          },
          "counted_quantity": {
            "type": "number"
          },
          "net_base_unit_price": {
            "type": "number"
          },
          "stock_revision": {
            "type": "integer",
            "minimum": 0
          },
          "count_version": {
            "type": "integer",
            "minimum": 0
          },
          "locked": {
            "type": "boolean"
          },
          "booked": {
            "type": "boolean"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "count_units": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "base_quantity": {
                  "type": "number",
                  "minimum": 1e-06
                },
                "whole_numbers_only": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "code",
                "label",
                "base_quantity"
              ]
            },
            "description": "Artikelbezogene Zähleinheiten; Einkaufseinheiten bleiben gesondert im SupplierItem"
          },
          "subcategory_id": {
            "type": "string"
          },
          "subcategory_name": {
            "type": "string"
          }
        }
      }
    },
    "request_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        }
      }
    },
    "discarded_at": {
      "type": "string",
      "description": "Zeitpunkt der reversiblen Entfernung eines ausschließlich ungebuchten Zwischenstands; leer nach Wiederherstellung"
    },
    "discarded_by": {
      "type": "string",
      "description": "Geprüfter Administrator; Revision und request_receipts bewahren die Vorgänge"
    }
  },
  "required": [
    "outlet_id",
    "actor_id",
    "start_key",
    "start_fingerprint",
    "session_date",
    "period_type",
    "status",
    "revision",
    "entries",
    "request_receipts"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  },
  "description": "Geschützte Inventursitzungen. Lesen und Schreiben ausschließlich über den authentifizierten Sitzungsdienst."
}
