{
  "name": "PriceChangeRequest",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string"
    },
    "outlet_item_id": {
      "type": "string"
    },
    "delivery_line_id": {
      "type": "string"
    },
    "proposed_by": {
      "type": "string"
    },
    "current_net_base_unit_price": {
      "type": "number",
      "minimum": 0
    },
    "proposed_net_base_unit_price": {
      "type": "number",
      "minimum": 0
    },
    "unit_abbreviation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "outlet_id",
    "outlet_item_id",
    "delivery_line_id",
    "proposed_by",
    "proposed_net_base_unit_price",
    "unit_abbreviation",
    "status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
