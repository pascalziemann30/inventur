{
  "name": "PriceHistory",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "Artikel-ID"
    },
    "article_name": {
      "type": "string",
      "description": "Artikelname (Schnellzugriff)"
    },
    "old_price": {
      "type": "number",
      "description": "Alter Preis"
    },
    "new_price": {
      "type": "number",
      "description": "Neuer Preis"
    },
    "change_date": {
      "type": "string",
      "format": "date",
      "description": "Datum der Änderung"
    },
    "changed_by": {
      "type": "string",
      "description": "Geändert von (User Email)"
    },
    "reason": {
      "type": "string",
      "description": "Grund der Änderung"
    }
  },
  "required": [
    "article_id",
    "new_price",
    "change_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
