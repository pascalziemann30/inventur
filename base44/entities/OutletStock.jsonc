{
  "name": "OutletStock",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "description": "Outlet/Standort ID"
    },
    "outlet_name": {
      "type": "string",
      "description": "Outlet Name (Schnellzugriff)"
    },
    "outlet_item_id": {
      "type": "string",
      "description": "OutletItem-ID (outlet-spezifischer Artikel)"
    },
    "global_item_id": {
      "type": "string",
      "description": "GlobalItem-ID (für Aggregation)"
    },
    "display_name": {
      "type": "string",
      "description": "Artikelname (Schnellzugriff)"
    },
    "on_hand_quantity": {
      "type": "number",
      "default": 0,
      "description": "Aktueller Lagerbestand für dieses Outlet"
    },
    "unit_abbreviation": {
      "type": "string",
      "description": "Einheit"
    }
  },
  "required": [
    "outlet_id",
    "outlet_item_id",
    "global_item_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
